# Copy to .env.local and fill in. Never commit real keys.

# --- Meta Model API (required) ---
# Create at https://dev.meta.ai (dashboard > API keys). Keys start with LLM_
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
# muse-spark-1.3 (Standard mode, content not used for training) is the default.
# muse-spark-1.3-contributor is ~10x cheaper but Meta may train on the content:
# use it ONLY for dev runs on public filings + the fictional sample portfolio.
MODEL_ID=muse-spark-1.3

# --- Optional: Baseten (Muse Spark Open, only if credits are granted) ---
# meta | baseten
LLM_PROVIDER=meta
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026

# --- SEC EDGAR (required, no key) ---
# SEC asks every automated client to declare a User-Agent with a contact email.
SEC_USER_AGENT="Fynex Copilot hackathon contact@example.com"

# --- Budget guards (USD, computed from token usage) ---
MAX_USD_PER_RUN=3
BUDGET_USD_TOTAL=100
MAX_HOLDINGS_PER_RUN=15

# --- Public deployment guards ---
# When set, live (paid) analysis requires this passcode; without it the public
# site only replays the cached sample run.
LIVE_RUN_PASSCODE=
# true = never call the model, serve fixtures only (safe for previews)
DEMO_READONLY=false
